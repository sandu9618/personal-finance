@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="text-danger">@Model.Error</p>
}

<table class="table">
    <tbody>
        <tr>
            <th>Income</th>
            <td>@Model.Dashboard.TotalIncome.ToString("0.00")</td>
        </tr>
        <tr>
            <th>Expenses</th>
            <td>@Model.Dashboard.TotalExpense.ToString("0.00")</td>
        </tr>
        <tr>
            <th>Balance</th>
            <td>@Model.Dashboard.Balanace.ToString("0.00")</td>
        </tr>
        <tr>
            <th>Recent transactions</th>
            <td>@Model.Dashboard.RecentTransactions.Length</td>
        </tr>
    </tbody>
</table>

<h2>Spending by category</h2>
<table class="table">
    <thead>
        <tr>
            <th>Category</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Dashboard.ExpensesByCategory.Length == 0)
        {
            <tr>
                <td colspan="2">No expenses yet.</td>
            </tr>
        }
        @foreach (var row in Model.Dashboard.ExpensesByCategory)
        {
            <tr>
                <td>@row.CategoryName</td>
                <td>@row.Total.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>

<h2>Recent transactions</h2>
<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Amount</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Dashboard.RecentTransactions.Length == 0)
        {
            <tr>
                <td colspan="4">No transactions yet.</td>
            </tr>
        }
        @foreach (var transaction in Model.Dashboard.RecentTransactions)
        {
            <tr>
                <td>@transaction.TransactionDate.ToString("yyyy-MM-dd")</td>
                <td>@transaction.Type</td>
                <td>@transaction.Amount.ToString("0.00")</td>
                <td>@transaction.Description</td>
            </tr>
        }
    </tbody>
</table>
