@page
@model AccountsModel
@{
    ViewData["Title"] = "Accounts";
}

<h1>Accounts</h1>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="text-danger">@Model.Error</p>
}

<section class="panel">
<form method="get" class="list-filter">
    @if (Model.Id is Guid filterId)
    {
        <input type="hidden" name="id" value="@filterId" />
    }
    <div>
        <label asp-for="Name">Name</label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div>
        <label asp-for="Type">Type</label>
        <select asp-for="Type" class="form-select">
            <option value="">All types</option>
            @foreach (var type in Enum.GetValues<AccountType>())
            {
                <option value="@type">@type</option>
            }
        </select>
    </div>
    <div>
        <label asp-for="Currency">Currency</label>
        <input asp-for="Currency" class="form-control" maxlength="3" />
    </div>
    <button type="submit" class="btn btn-primary">Filter</button>
    <a asp-page="/Accounts" asp-route-id="@Model.Id">Clear</a>
</form>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Balance</th>
            <th>Type</th>
            <th>Currency</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Accounts.Length == 0)
        {
            <tr>
                <td colspan="5">@(Model.HasAnyAccounts ? "No accounts match this filter." : "No accounts yet.")</td>
            </tr>
        }
        @foreach (var account in Model.Accounts)
        {
            <tr>
                <td>@account.Name</td>
                <td>@account.Balance.ToString("0.00") @account.Currency</td>
                <td>@account.Type</td>
                <td>@account.Currency</td>
                <td>
                    <a asp-page="/Accounts" asp-route-id="@account.Id" asp-route-name="@Model.Name" asp-route-type="@Model.Type" asp-route-currency="@Model.Currency">Edit</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@account.Id" class="d-inline">
                        <input type="hidden" asp-for="Name" />
                        <input type="hidden" asp-for="Type" />
                        <input type="hidden" asp-for="Currency" />
                        <button type="submit" class="btn btn-link p-0 align-baseline">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</section>

<section class="panel panel-form">
<h2>@(Model.Id is null ? "New account" : "Edit account")</h2>
<form method="post" class="editor">
    @if (Model.Id is Guid id)
    {
        <input type="hidden" name="id" value="@id" />
    }
    <input type="hidden" asp-for="Name" />
    <input type="hidden" asp-for="Type" />
    <input type="hidden" asp-for="Currency" />
    <div class="mb-3">
        <label asp-for="Input.Name"></label>
        <input asp-for="Input.Name" class="form-control" maxlength="100" />
    </div>
    <div class="mb-3">
        <label asp-for="Input.InitialBalance"></label>
        <input asp-for="Input.InitialBalance" class="form-control" type="number" step="0.01" />
    </div>
    <div class="mb-3">
        <label asp-for="Input.Type"></label>
        <select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<AccountType>()" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Currency"></label>
        <input asp-for="Input.Currency" class="form-control" maxlength="3" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    @if (Model.Id is not null)
    {
        <a asp-page="/Accounts" class="ms-2">Cancel</a>
    }
</form>
</section>
