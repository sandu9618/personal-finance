@page
@model TransfersModel
@{
    ViewData["Title"] = "Transfers";
}

<h1>Transfers</h1>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="text-danger">@Model.Error</p>
}

<section class="panel">
<form method="get" class="list-filter">
    @if (Model.Id is Guid filterId)
    {
        <input type="hidden" name="id" value="@filterId" />
    }
    <div>
        <label asp-for="FromAccountId"></label>
        <select asp-for="FromAccountId" class="form-select">
            <option value="">All accounts</option>
            @foreach (var account in Model.Accounts)
            {
                <option value="@account.Id">@account.Name (@account.Currency)</option>
            }
        </select>
    </div>
    <div>
        <label asp-for="ToAccountId"></label>
        <select asp-for="ToAccountId" class="form-select">
            <option value="">All accounts</option>
            @foreach (var account in Model.Accounts)
            {
                <option value="@account.Id">@account.Name (@account.Currency)</option>
            }
        </select>
    </div>
    <div>
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" maxlength="500" />
    </div>
    <div>
        <label asp-for="From"></label>
        <input asp-for="From" class="form-control" type="date" />
    </div>
    <div>
        <label asp-for="To"></label>
        <input asp-for="To" class="form-control" type="date" />
    </div>
    <button type="submit" class="btn btn-primary">Filter</button>
    <a asp-page="/Transfers" asp-route-id="@Model.Id">Clear</a>
</form>
<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>From</th>
            <th>To</th>
            <th>Amount</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Transfers.Length == 0)
        {
            <tr>
                <td colspan="6">@(Model.HasAnyTransfers ? "No transfers match this filter." : "No transfers yet.")</td>
            </tr>
        }
        @foreach (var transfer in Model.Transfers)
        {
            <tr>
                <td>@transfer.TransferDate.ToString("yyyy-MM-dd")</td>
                <td>@Model.AccountName(transfer.FromAccountId)</td>
                <td>@Model.AccountName(transfer.ToAccountId)</td>
                <td>@Model.Money(transfer)</td>
                <td>@transfer.Description</td>
                <td>
                    <a asp-page="/Transfers" asp-route-id="@transfer.Id" asp-route-fromAccountId="@Model.FromAccountId" asp-route-toAccountId="@Model.ToAccountId" asp-route-description="@Model.Description" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">Edit</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@transfer.Id" class="d-inline">
                        <input type="hidden" asp-for="FromAccountId" />
                        <input type="hidden" asp-for="ToAccountId" />
                        <input type="hidden" asp-for="Description" />
                        <input type="hidden" asp-for="From" />
                        <input type="hidden" asp-for="To" />
                        <button type="submit" class="btn btn-link p-0 align-baseline">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</section>

<section class="panel panel-form">
<h2>@(Model.Id is null ? "New transfer" : "Edit transfer")</h2>
<form method="post" class="editor">
    @if (Model.Id is Guid id)
    {
        <input type="hidden" name="id" value="@id" />
    }
    <input type="hidden" asp-for="FromAccountId" />
    <input type="hidden" asp-for="ToAccountId" />
    <input type="hidden" asp-for="Description" />
    <input type="hidden" asp-for="From" />
    <input type="hidden" asp-for="To" />
    <div class="mb-3">
        <label asp-for="Input.FromAccountId"></label>
        <select asp-for="Input.FromAccountId" asp-items="Model.AccountOptions" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Input.ToAccountId"></label>
        <select asp-for="Input.ToAccountId" asp-items="Model.AccountOptions" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Amount"></label>
        <input asp-for="Input.Amount" class="form-control" type="number" step="0.01" />
    </div>
    <div class="mb-3">
        <label asp-for="Input.Description"></label>
        <input asp-for="Input.Description" class="form-control" maxlength="500" />
    </div>
    <div class="mb-3">
        <label asp-for="Input.TransferDate"></label>
        <input asp-for="Input.TransferDate" class="form-control" type="date" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    @if (Model.Id is not null)
    {
        <a asp-page="/Transfers" asp-route-fromAccountId="@Model.FromAccountId" asp-route-toAccountId="@Model.ToAccountId" asp-route-description="@Model.Description" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" class="ms-2">Cancel</a>
    }
</form>
</section>
