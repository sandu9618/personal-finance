@page
@model LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Log in";
}

<div class="auth-card">
    <p class="auth-kicker">Welcome back</p>
    <h1>Log in</h1>
    <p class="auth-lead">Open your accounts, categories, and recent spending.</p>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="auth-error">@Model.Error</p>
    }
    <form method="post">
        <div class="mb-3">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" class="form-control" type="email" autocomplete="username" />
        </div>
        <div class="mb-3">
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" class="form-control" type="password" autocomplete="current-password" />
        </div>
        <button type="submit" class="btn btn-primary auth-submit">Log in</button>
    </form>
    <p class="auth-switch">New here? <a asp-page="/Register">Create an account</a></p>
</div>
