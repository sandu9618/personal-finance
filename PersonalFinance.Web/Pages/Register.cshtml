@page
@model RegisterModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register";
}

<div class="auth-card">
    <p class="auth-kicker">Get started</p>
    <h1>Create an account</h1>
    <p class="auth-lead">A few details, then you can track income, expenses, and what you set aside.</p>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="auth-error">@Model.Error</p>
    }
    <form method="post">
        <div class="mb-3">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" class="form-control" type="email" autocomplete="username" />
        </div>
        <div class="mb-3">
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" />
            <div class="form-text">At least 6 characters, with an uppercase letter, a lowercase letter, a digit, and a symbol.</div>
        </div>
        <button type="submit" class="btn btn-primary auth-submit">Create account</button>
    </form>
    <p class="auth-switch">Already registered? <a asp-page="/Login">Log in</a></p>
</div>
