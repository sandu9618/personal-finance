@page
@model TransactionsModel
@{
    ViewData["Title"] = "Transactions";
}

<h1>Transactions</h1>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="text-danger">@Model.Error</p>
}

<section class="panel">
<form method="get" class="list-filter">
    @if (Model.Id is Guid filterId)
    {
        <input type="hidden" name="id" value="@filterId" />
    }
    <div>
        <label asp-for="AccountId">Account</label>
        <select asp-for="AccountId" class="form-select">
            <option value="">All accounts</option>
            @foreach (var account in Model.Accounts)
            {
                <option value="@account.Id">@account.Name (@account.Currency)</option>
            }
        </select>
    </div>
    <div>
        <label asp-for="CategoryId">Category</label>
        <select asp-for="CategoryId" class="form-select">
            <option value="">All categories</option>
            <option value="@Guid.Empty">No category</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>
    <div>
        <label asp-for="Type">Type</label>
        <select asp-for="Type" class="form-select">
            <option value="">All types</option>
            @foreach (var type in Enum.GetValues<TransactionType>())
            {
                <option value="@type">@type</option>
            }
        </select>
    </div>
    <div>
        <label asp-for="Description">Description</label>
        <input asp-for="Description" class="form-control" maxlength="500" />
    </div>
    <div>
        <label asp-for="From">From</label>
        <input asp-for="From" class="form-control" type="date" />
    </div>
    <div>
        <label asp-for="To">To</label>
        <input asp-for="To" class="form-control" type="date" />
    </div>
    <button type="submit" class="btn btn-primary">Filter</button>
    <a asp-page="/Transactions" asp-route-id="@Model.Id">Clear</a>
</form>
<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Account</th>
            <th>Category</th>
            <th>Type</th>
            <th>Amount</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Transactions.Length == 0)
        {
            <tr>
                <td colspan="7">@(Model.HasAnyTransactions ? "No transactions match this filter." : "No transactions yet.")</td>
            </tr>
        }
        @foreach (var transaction in Model.Transactions)
        {
            <tr>
                <td>@transaction.TransactionDate.ToString("yyyy-MM-dd")</td>
                <td>@Model.AccountName(transaction.AccountId)</td>
                <td>@Model.CategoryName(transaction.CategoryId)</td>
                <td>@transaction.Type</td>
                <td>@Model.Money(transaction)</td>
                <td>@transaction.Description</td>
                <td>
                    @if (Model.CanChange(transaction))
                    {
                        <a asp-page="/Transactions" asp-route-id="@transaction.Id" asp-route-accountId="@Model.AccountId" asp-route-categoryId="@Model.CategoryId" asp-route-type="@Model.Type" asp-route-description="@Model.Description" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@transaction.Id" class="d-inline">
                            <input type="hidden" asp-for="AccountId" />
                            <input type="hidden" asp-for="CategoryId" />
                            <input type="hidden" asp-for="Type" />
                            <input type="hidden" asp-for="Description" />
                            <input type="hidden" asp-for="From" />
                            <input type="hidden" asp-for="To" />
                            <button type="submit" class="btn btn-link p-0 align-baseline">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</section>

<section class="panel panel-form">
<h2>@(Model.Id is null ? "New transaction" : "Edit transaction")</h2>
<form method="post" class="editor">
    @if (Model.Id is Guid id)
    {
        <input type="hidden" name="id" value="@id" />
    }
    <input type="hidden" asp-for="AccountId" />
    <input type="hidden" asp-for="CategoryId" />
    <input type="hidden" asp-for="Type" />
    <input type="hidden" asp-for="Description" />
    <input type="hidden" asp-for="From" />
    <input type="hidden" asp-for="To" />
    <div class="mb-3">
        <label asp-for="Input.AccountId"></label>
        <select asp-for="Input.AccountId" asp-items="Model.AccountOptions" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Type"></label>
        <select asp-for="Input.Type" class="form-select" id="transaction-type">
            <option value="@((int)TransactionType.Income)">Income</option>
            <option value="@((int)TransactionType.Expense)">Expense</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Input.CategoryId"></label>
        <select asp-for="Input.CategoryId" class="form-select" id="transaction-category">
            @foreach (var category in Model.Categories)
            {
                if (category.Id == Model.Input.CategoryId)
                {
                    <option value="@category.Id" data-type="@((int)category.Type)" selected>@category.Name</option>
                }
                else
                {
                    <option value="@category.Id" data-type="@((int)category.Type)">@category.Name</option>
                }
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Amount"></label>
        <input asp-for="Input.Amount" class="form-control" type="number" step="0.01" />
    </div>
    <div class="mb-3">
        <label asp-for="Input.Description"></label>
        <input asp-for="Input.Description" class="form-control" maxlength="500" />
    </div>
    <div class="mb-3">
        <label asp-for="Input.TransactionDate"></label>
        <input asp-for="Input.TransactionDate" class="form-control" type="date" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    @if (Model.Id is not null)
    {
        <a asp-page="/Transactions" asp-route-accountId="@Model.AccountId" asp-route-categoryId="@Model.CategoryId" asp-route-type="@Model.Type" asp-route-description="@Model.Description" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" class="ms-2">Cancel</a>
    }
</form>
</section>

@section Scripts {
    <script>
        const typeSelect = document.getElementById("transaction-type");
        const categorySelect = document.getElementById("transaction-category");
        if (typeSelect && categorySelect) {
            function filterCategories() {
                const type = typeSelect.value;
                let firstMatch = null;
                for (const option of categorySelect.options) {
                    const matches = option.dataset.type === type;
                    option.hidden = !matches;
                    option.disabled = !matches;
                    if (matches && firstMatch === null) {
                        firstMatch = option;
                    }
                }
                const selected = categorySelect.selectedOptions[0];
                if ((!selected || selected.disabled) && firstMatch) {
                    categorySelect.value = firstMatch.value;
                }
            }
            typeSelect.addEventListener("change", filterCategories);
            filterCategories();
        }
    </script>
}
