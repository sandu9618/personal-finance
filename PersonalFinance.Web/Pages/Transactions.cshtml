@page
@model TransactionsModel
@{
    ViewData["Title"] = "Transactions";
}

<h1>Transactions</h1>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="text-danger">@Model.Error</p>
}

<section class="panel">
<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Account</th>
            <th>Category</th>
            <th>Type</th>
            <th>Amount</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Transactions.Length == 0)
        {
            <tr>
                <td colspan="7">No transactions yet.</td>
            </tr>
        }
        @foreach (var transaction in Model.Transactions)
        {
            <tr>
                <td>@transaction.TransactionDate.ToString("yyyy-MM-dd")</td>
                <td>@Model.AccountName(transaction.AccountId)</td>
                <td>@Model.CategoryName(transaction.CategoryId)</td>
                <td>@transaction.Type</td>
                <td>@Model.Money(transaction)</td>
                <td>@transaction.Description</td>
                <td>
                    <a asp-page="/Transactions" asp-route-id="@transaction.Id">Edit</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@transaction.Id" class="d-inline">
                        <button type="submit" class="btn btn-link p-0 align-baseline">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</section>

<section class="panel panel-form">
<h2>@(Model.Id is null ? "New transaction" : "Edit transaction")</h2>
<form method="post" class="editor">
    @if (Model.Id is Guid id)
    {
        <input type="hidden" name="id" value="@id" />
    }
    <div class="mb-3">
        <label asp-for="Input.AccountId"></label>
        <select asp-for="Input.AccountId" asp-items="Model.AccountOptions" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Type"></label>
        <select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<TransactionType>()" class="form-select" id="transaction-type"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Input.CategoryId"></label>
        <select asp-for="Input.CategoryId" class="form-select" id="transaction-category">
            @foreach (var category in Model.Categories)
            {
                if (category.Id == Model.Input.CategoryId)
                {
                    <option value="@category.Id" data-type="@((int)category.Type)" selected>@category.Name</option>
                }
                else
                {
                    <option value="@category.Id" data-type="@((int)category.Type)">@category.Name</option>
                }
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Amount"></label>
        <input asp-for="Input.Amount" class="form-control" type="number" step="0.01" />
    </div>
    <div class="mb-3">
        <label asp-for="Input.Description"></label>
        <input asp-for="Input.Description" class="form-control" maxlength="500" />
    </div>
    <div class="mb-3">
        <label asp-for="Input.TransactionDate"></label>
        <input asp-for="Input.TransactionDate" class="form-control" type="date" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    @if (Model.Id is not null)
    {
        <a asp-page="/Transactions" class="ms-2">Cancel</a>
    }
</form>
</section>

@section Scripts {
    <script>
        const typeSelect = document.getElementById("transaction-type");
        const categorySelect = document.getElementById("transaction-category");
        if (typeSelect && categorySelect) {
            function filterCategories() {
                const type = typeSelect.value;
                let firstMatch = null;
                for (const option of categorySelect.options) {
                    const matches = option.dataset.type === type;
                    option.hidden = !matches;
                    option.disabled = !matches;
                    if (matches && firstMatch === null) {
                        firstMatch = option;
                    }
                }
                const selected = categorySelect.selectedOptions[0];
                if ((!selected || selected.disabled) && firstMatch) {
                    categorySelect.value = firstMatch.value;
                }
            }
            typeSelect.addEventListener("change", filterCategories);
            filterCategories();
        }
    </script>
}
